# GCP Project & KMS Configuration
export PROJECT_ID="your-project-id"
export KMS_PROJECT_ID="$PROJECT_ID"
export LOCATION="europe-west8"
export KEY_RING="agent-engine"
export KEY_NAME="agent-engine-key"

# Python SDK Environment Variables
export GOOGLE_CLOUD_PROJECT="$PROJECT_ID"
export GOOGLE_CLOUD_LOCATION="$LOCATION"
export KMS_KEY_NAME="projects/${KMS_PROJECT_ID}/locations/${LOCATION}/keyRings/${KEY_RING}/cryptoKeys/${KEY_NAME}"

# Populated after running create_instance.py
# export AGENT_RUNTIME_NAME="projects/<PROJECT_NUMBER>/locations/europe-west8/reasoningEngines/<ENGINE_ID>"

# Populated after running create_shell_template.py
# export SANDBOX_TEMPLATE_NAME="projects/<PROJECT_NUMBER>/locations/europe-west8/reasoningEngines/<ENGINE_ID>/sandboxEnvironmentTemplates/<TEMPLATE_ID>"

# Optional tuning (billing safety). Sandboxes are billed per second.
# export AGENT_SANDBOX_DEFAULT_TTL=900     # seconds
# export AGENT_SANDBOX_MAX_TTL=3600        # hard cap on any requested TTL
# export AGENT_SANDBOX_STATE="$HOME/.agent-sandbox/state.json"   # ledger of sandboxes started here
# export AGENT_SANDBOX_ENV="$HOME/.config/agent-sandbox/env"     # explicit env file (installed CLI)
